# Public site URL used for SEO metadata, canonical URLs, sitemap, and robots
NEXT_PUBLIC_SITE_URL=https://beoksmart.com

# Optional: factory reorder email used by /api/order-request inventory alerts
FACTORY_ORDER_EMAIL=orders@example.com

# Required for Stripe Checkout payment session creation
STRIPE_SECRET_KEY=sk_test_xxx

# Required for Stripe webhook signature verification (/api/checkout/webhook)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: customer confirmation emails (Resend)
RESEND_API_KEY=re_xxx
ORDER_EMAIL_FROM=BEOKBG <orders@beoksmart.com>

# Optional: protect /[locale]/admin/orders page via ?token=
ADMIN_ORDERS_TOKEN=change_me

# Public site URL used for SEO metadata, canonical URLs, sitemap, and robots
NEXT_PUBLIC_SITE_URL=https://beoksmart.com

# Optional: PostgreSQL connection string for persistent stock and order data
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Optional: factory reorder email used by /api/order-request inventory alerts
FACTORY_ORDER_EMAIL=orders@example.com

# Required for Stripe Checkout payment session creation
STRIPE_SECRET_KEY=sk_test_xxx

# Required for Stripe webhook signature verification (/api/checkout/webhook)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: customer confirmation emails (Resend)
RESEND_API_KEY=re_xxx
ORDER_EMAIL_FROM=BEOKBG <orders@beoksmart.com>
# Optional: send a copy of every paid-order email to your business inbox
ORDER_NOTIFICATION_EMAIL=beokbg@gmail.com
# Optional: recipient for "order request" form submissions (fallbacks to ORDER_NOTIFICATION_EMAIL)
ORDER_REQUEST_NOTIFICATION_EMAIL=beokbg@gmail.com

# Sameday API v3.4 credentials and endpoints
SAMEDAY_BASE_URL=https://sameday-api.demo.zitec.com
SAMEDAY_USERNAME=
SAMEDAY_PASSWORD=

# Keep defaults unless your account uses custom routes
SAMEDAY_AUTH_PATH=/api/authenticate
SAMEDAY_AUTH_REMEMBER_ME=true
SAMEDAY_AWB_PATH=/api/awb
SAMEDAY_LOCKERS_PATH=/api/client/ooh-locations

# Contract/account settings
SAMEDAY_CLIENT_ID=
SAMEDAY_PICKUP_POINT_ID=
SAMEDAY_SERVICE_ID=7
# Optional delivery-type-specific override (recommended)
SAMEDAY_SERVICE_ID_ADDRESS=7
SAMEDAY_SERVICE_ID_EASYBOX=15

# Optional AWB behavior
SAMEDAY_ENABLE_COD=false
SAMEDAY_PARCEL_WEIGHT_KG=1
SAMEDAY_PARCEL_LENGTH_CM=20
SAMEDAY_PARCEL_WIDTH_CM=15
SAMEDAY_PARCEL_HEIGHT_CM=10
SAMEDAY_PACKAGE_TYPE=0

# Optional recipient fallback values used when checkout data is incomplete
SAMEDAY_RECIPIENT_COUNTY_DEFAULT=
SAMEDAY_RECIPIENT_CITY_DEFAULT=

# Optional client/network tuning
SAMEDAY_REQUEST_TIMEOUT_MS=12000
SAMEDAY_RETRY_COUNT=2

# Optional: protect /[locale]/admin/orders page via ?token=
ADMIN_ORDERS_TOKEN=change_me

EMAG_USERNAME=

EMAG_PASSWORD=

EMAG_BASE_URL=https://marketplace-api.emag.ro/api-3

EMAG_ADMIN_TOKEN=

# Optional: override file for per-product eMAG fields (brand/ean/description/stock/measurements)
# Recommended flow: keep EAN in the main price sheet and use env defaults for the rest.
# Use this only when you need per-product exceptions.
EMAG_OVERRIDES_PATH=data/products/emag.overrides.json

GOOGLE_SITE_VERIFICATION=change_me

{
  "name": "beokbg",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=20 <25"
  },
  "description": "This project is a modern, modular, and responsive web application for a hardware distributor, inspired by [bg.beok-controls.com](https://bg.beok-controls.com). Built with Next.js, TypeScript, and Tailwind CSS.",
  "main": "next.config.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "host:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-host.ps1",
    "host:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-host.ps1",
    "prices:import": "node ./scripts/import-prices.mjs",
    "images:import": "node ./scripts/import-product-images.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/pg": "^8.21.0",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-medium-image-zoom": "^5.4.9",
    "stripe": "^22.5.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "xlsx": "^0.18.5"
  }
}
